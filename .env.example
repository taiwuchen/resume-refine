# Every value here is optional for local development.

# Callers supply their own OpenRouter key in the browser, which the backend
# forwards without storing. Set these two only if you want the server to fall
# back to its own key for local work -- never enable this on a public
# deployment, where it would let anonymous callers spend your credits.
ALLOW_SERVER_API_KEY=false
OPENROUTER_API_KEY=

OPENROUTER_MODEL=openai/gpt-5-nano

# Browser origins allowed to call the API. A deployment must set this to its
# real frontend origin.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GOTENBERG_URL=http://localhost:3000
GOTENBERG_TIMEOUT_SECONDS=60

# Upload and parsing limits. A DOCX is a ZIP archive, so a small file can
# expand to gigabytes; these bound that.
MAX_UPLOAD_BYTES=5242880
MAX_EXPANDED_BYTES=41943040
MAX_COMPRESSION_RATIO=120

# How long an uploaded resume is retained before it is deleted.
DOCUMENT_TTL_SECONDS=86400
